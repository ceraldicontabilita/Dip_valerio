# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env (è già in .gitignore).

# Connection string MongoDB Atlas (o self-hosted). Es: mongodb+srv://user:pass@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=

# Nome del database dedicato a questa app — tenerlo SEPARATO da altri database
# (es. non usare "Gestionale", quello è di un'altra applicazione).
DB_NAME=ceraldi_presenze

# Segreto per firmare i JWT di sessione (stringa lunga e casuale)
JWT_SECRET=

# Porta HTTP del server
PORT=4000

# Origini frontend ammesse per CORS (separate da virgola, oppure * per tutte)
CORS_ORIGINS=*

# Bot Telegram admin (notifiche verso l'amministratore)
TG_TOKEN_ADMIN=
TG_CHAT_ADMIN=

# Bot Telegram dipendenti (@CeraldiPresenze_bot o equivalente)
TG_TOKEN_DIPENDENTI=

# URL pubblico dell'app frontend (per i deep-link nei messaggi Telegram)
APP_URL=

# Usati solo una tantum da "node src/seed-admin.js" per creare/reimpostare
# l'account amministratore iniziale — non servono al server in esecuzione.
ADMIN_EMAIL=
ADMIN_PASSWORD=
